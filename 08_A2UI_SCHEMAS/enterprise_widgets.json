        {
          "type": "MetricRow",
          "props": { "label": "Сумма к оплате", "value": "$1,240", "color": "var(--emerald-400)" }
        },
        {
          "type": "ActionButton",
          "props": {
            "label": "Записать в Реестр Sheets",
