                "confirm": "Подтвердите отправку КП в адрес клиента?"
              }
            },
            {
              "type": "ActionButton",
              "props": {
                "label": "Открыть расчет в Sheets",
                "variant": "indigo",
                "icon": "📊",
                "action": "open_sheets"
