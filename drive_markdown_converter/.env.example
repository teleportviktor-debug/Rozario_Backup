# ============================================================================
# GOOGLE DRIVE MARKDOWN CONVERTER • ZERO-FRICTION CONFIGURATION
# ============================================================================

# САМЫЙ ПРОСТОЙ СПОСОБ: Вставьте весь текст из service_account.json как есть
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# ИЛИ укажите путь к локальному файлу (для локального запуска)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# Названия папок на Google Диске (создаются автоматически)
DRIVE_INBOX_FOLDER=01_INBOX
DRIVE_NOTEBOOK_FOLDER=02_FOR_NOTEBOOK
DRIVE_ARCHIVE_FOLDER=_ARCHIVE

# Настройки работы
POLL_INTERVAL_SECONDS=30
BATCH_SIZE_LIMIT=20
LOCAL_TEMP_DIR=/tmp/drive_converter
